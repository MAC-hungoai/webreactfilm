# Database
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/netflix?appName=Cluster"

# NextAuth
NEXTAUTH_URL=https://your-app.com
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# API URLs
NEXT_PUBLIC_API_URL=https://your-api-url.com

# OAuth (Google)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# OAuth (GitHub)
GITHUB_CLIENT_ID=your-github-client-id-here
GITHUB_CLIENT_SECRET=your-github-client-secret-here

# Admin Configuration
ADMIN_EMAILS=admin@example.com
ADMIN_JWT_SECRET=your-admin-jwt-secret-key-change-in-production

# Frontend Configuration (NEXT_PUBLIC_* will be exposed to browser)
NEXT_PUBLIC_ENABLE_YOUTUBE_HERO_BANNER=1
NEXT_PUBLIC_HERO_BANNER_ROTATE_MS=30000
NEXT_PUBLIC_BRAND_INTRO_URL=https://youtu.be/GV3HUDMQ-F8?si=gQQSweVWrmLqX2Vd
NEXT_PUBLIC_BRAND_INTRO_DURATION_MS=4000
NEXT_PUBLIC_INTRO_MUTED=0
NEXT_PUBLIC_INTRO_AUTOPLAY_MUTED=0
NEXT_PUBLIC_WATCH_AUTOPLAY_MUTED=0
NEXT_PUBLIC_MEDIA_MIRROR_BASE_URL=/media

# Node Environment
NODE_ENV=production
